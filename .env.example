# ============================================================
#  Aussy Ontech — Variáveis de ambiente
#  Copie para .env (local) ou configure no painel da Vercel.
# ============================================================

# URL pública do site (sem barra final).
# Em produção na Vercel, use o domínio final (ex: https://aussy.vercel.app
# ou https://aussy-ontech.com.br). Importante para metadata e OpenGraph.
NEXT_PUBLIC_SITE_URL=https://aussy-ontech.vercel.app

# ============================================================
#  NOTAS:
#
#  - O app é 100% offline-first e não exige chaves de API
#    pagas para funcionar. Todas as APIs brasileiras usadas
#    (INMET, CEMADEN, INPE, CPTEC, IBGE, ANA, USGS, NASA EONET)
#    são públicas e não requerem autenticação.
#
#  - A rota /api/coverage/towers gera dados representativos
#    (a base completa ANATEL ERB-Web tem 200k+ torres).
#
#  - Em desenvolvimento local use http://localhost:3000
# ============================================================
